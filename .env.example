# ScribeShelf environment variables
#
# Copy this file to .env.local for local development.
# Never commit real credentials or tokens.
# Public project settings from Supabase's Connect dialog.
# Leave both blank to run the design preview without a backend.
# Use an sb_publishable_ key, never a secret or service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
